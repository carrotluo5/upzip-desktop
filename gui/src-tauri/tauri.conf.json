{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Upzip",
  "version": "0.4.1",
  "identifier": "com.nanase.upzip",
  "build": {
    "beforeDevCommand": "pnpm sync:binaries && pnpm build",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm sync:binaries && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Upzip — 智能批量解压",
        "width": 1120,
        "height": 780,
        "minWidth": 880,
        "minHeight": 560,
        "resizable": true,
        "center": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "resources": [
      "binaries/mac/7zz",
      "binaries/7z-LICENSE.txt"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "Upzip — 智能批量解压工具",
    "longDescription": "批量解压 zip/7z/rar/分卷、伪装容器、自解压文件及 Paranoia (SSEFE v4) 容器。",
    "copyright": "© 2026 nanase",
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
